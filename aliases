## LLM and AI Chats
alias alpaca="flatpak run com.jeffser.Alpaca"
alias start-llm="nvidia-smi -pm 1 && systemctl --user start ollama"
alias stop-llm="nvidia-smi -pm 0 && systemctl --user stop ollama"

# Waydroid management
alias wc-start="sudo waydroid container start"
alias wc-stop="sudo waydroid container stop"
alias ws-stop="waydroid session stop"

# Git related
alias gitl="git log --graph --abbrev-commit --decorate --all"
alias gitls="git log --graph --oneline --decorate --all"
alias gitc="git commit -m "
alias gits="git status"
alias gita="git add"
alias gitps="git push"
alias gitpu="git pull"
alias gitf="git fetch --all"
alias checkout="git checkout"
alias branch="git checkout -B"

# Miscellaneous
alias updeck="nohup ~/OBS/UPDeck/love ~/OBS/UPDeck/UPDeck.love > /dev/null 2>&1 &"
alias searchproc="ps aux | grep -i "
alias artisan="php artisan "
alias projetos="cd ~/Projetos"

## Podman Container management
alias podman-start="systemctl --user start podman.socket"
alias podman-stop="systemctl --user stop podman.socket"
alias podman-status="systemctl --user status podman.socket"
alias pc="podman compose"

## System management
alias sysupgrade="sh ~/Projetos/dotfiles/distro-setup/upgrade.sh"
